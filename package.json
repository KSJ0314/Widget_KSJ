    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "styled-components": "^6.4.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
